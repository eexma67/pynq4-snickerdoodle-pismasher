++++ b/src/runtime_src/core/edge/drm/zocl/include/zocl_aie.h
+@@ -147,6 +147,18 @@ static inline void
+ aie_free_errors(struct aie_errors *aie_errs)
+ {
+ }
++
++static inline int
++aie_partition_get_freq(struct device *dev, u64 *freq)
++{
++	return -EINVAL;
++}
++
++static inline int
++aie_partition_set_freq_req(struct device *dev, u64 freq)
++{
++	return -EINVAL;
++}
+ #endif
+ int zocl_read_aieresbin(struct drm_zocl_slot *slot, struct axlf* axlf, char __user *xclbin);
+ struct aie_info {
+diff --git a/src/runtime_src/core/include/xrt/detail/xrt_error_code.h b/src/runtime_src/core/include/xrt/detail/xrt_error_code.h
