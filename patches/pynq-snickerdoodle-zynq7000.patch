diff --git a/sdbuild/packages/python_packages_noble/qemu.sh b/sdbuild/packages/python_packages_noble/qemu.sh
index 9592fa1..c4e57aa 100755
--- a/sdbuild/packages/python_packages_noble/qemu.sh
+++ b/sdbuild/packages/python_packages_noble/qemu.sh
@@ -20,5 +20,30 @@ source /etc/profile.d/pynq_venv.sh
 # setuptools==59.6.0) don't install on Python 3.12.
 python3 -m pip install --upgrade wheel
 
+# armhf gets few binary wheels, so meson/pybind11 packages (contourpy,
+# matplotlib, ...) build from source. Hide Ubuntu's pybind11 2.11 pkg-config
+# file so meson uses the pybind11 from the isolated build environment.
+pybind11_pc=/usr/share/pkgconfig/pybind11.pc
+if [ "$(uname -m)" = "armv7l" ]; then
+    if [ -f ${pybind11_pc} ]; then
+        mv ${pybind11_pc} ${pybind11_pc}.hidden
+        trap "mv ${pybind11_pc}.hidden ${pybind11_pc}" EXIT
+    fi
+    # ninja can deadlock under qemu-user (child exit never noticed), so let
+    # CMake-based builds use make. Link pyzmq against the system libzmq
+    # instead of building the bundled one.
+    export CMAKE_GENERATOR="Unix Makefiles"
+    export CMAKE_BUILD_PARALLEL_LEVEL=$(nproc)
+    export MAKEFLAGS="-j$(nproc)"
+    DEBIAN_FRONTEND=noninteractive apt-get install -y libzmq3-dev ninja-build
+    # Keep built wheels in the persistent ccache mount so a failed stage
+    # does not have to recompile everything under emulation.
+    export PIP_CACHE_DIR=/ccache/pip
+    # Packages without armv7l wheels compile against their build deps at
+    # their newest; Cython 3.3 rejects pyzmq 27.1's sources.
+    echo "cython<3.2" > /root/pip-build-constraints.txt
+    export PIP_BUILD_CONSTRAINT=/root/pip-build-constraints.txt
+fi
+
 python3 -m pip install -r requirements.txt
 rm requirements.txt
