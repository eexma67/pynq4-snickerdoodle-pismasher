# snickerdoodle black + piSmasher EDF (Yocto) build configuration.
#
# There is no AMD machine for this board, so the machine is generated from
# the base overlay's XSA (custom mode).

EDF_MANIFEST_TAG=amd-edf-rel-v25.11.1
EDF_MODE=custom
EDF_BOOT_MACHINE=snickerdoodle-pismasher-pynq
BSP_XSA_PATH=base/base.xsa
